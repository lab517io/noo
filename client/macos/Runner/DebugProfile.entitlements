<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox disabled — see Release.entitlements for rationale. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Voice memos need the microphone. Required in *both* entitlement
	     files: the debug build uses DebugProfile, the shipped one uses
	     Release, and a permission missing from either fails only in that
	     configuration. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
